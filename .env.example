# ==================================================
# Archivo de variables de entorno (.env)
# Copiar como .env y rellenar con los valores reales
# ==================================================

# ---- Registro de la App en Microsoft Entra ID (Azure AD) ----
# Estos valores los encuentras en: portal.azure.com > App registrations > Extractor Correos STOD
TENANT_ID=
CLIENT_ID=

# ---- Modo de autenticación ----
# "delegated" = inicias sesión con tu cuenta personal (Device Code + MFA). 
#               Lee TU propia bandeja (/me/messages).
# "app"       = Client Credentials (CLIENT_SECRET). Lee cualquier buzón.
#               Requiere permisos de Aplicación (no Delegados).
AUTH_MODE=delegated

# Correo con el que quieres iniciar sesión (usado para validar que no se use el buzón equivocado)
ACCOUNT_USERNAME=rcruz@canella.com.gt

# Solo para AUTH_MODE=app
CLIENT_SECRET=
MAILBOX=

# ---- Ruta de almacenamiento de documentos ----
# Árbol donde se guardarán: Empresa/Año/Mes/Día/Nit_nombre/Autorizador/Orden_de_compra
STORAGE_FOLDER=\\128.1.200.70\Carpeta_Compartida\PRUEBA_AUTOMATIZACION_CONTRASEÑA

# ---- Filtros de Correo ----
EMAIL_SUBJECT_FILTER=tramite de contrseña
# ---- Token cache ----
# Archivo donde se guarda el token para no volver a pedir login en cada arranque
TOKEN_CACHE_FILE=.token_cache.json
